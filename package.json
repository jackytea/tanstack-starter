{
  "name": "tanstack-starter",
  "version": "0.1.0",
  "private": true,
  "description": "TanStack Start template.",
  "license": "AGPL-3.0-only",
  "author": "Jacky Tea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackytea/tanstack-starter.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "src/client.tsx",
  "scripts": {
    "prepare": "husky",
    "dev": "vite dev",
    "build": "vite build",
    "serve": "vite preview",
    "migrate": "drizzle-kit migrate",
    "migrate:revert": "drizzle-kit drop",
    "start": "node .output/server/index.mjs",
    "knip": "knip --fix --allow-remove-files",
    "validate": "tsc && oxlint && oxfmt --check .",
    "fix": "pnpm knip && oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.33.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inlang/paraglide-js": "^2.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.88.0",
    "oxlint-tailwindcss": "^1.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
